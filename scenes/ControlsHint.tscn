[sub_resource type="SystemFont" id="SystemFont_cjk"]
font_names = PackedStringArray("Noto Sans CJK SC", "Noto Sans CJK", "Microsoft YaHei", "PingFang SC", "WenQuanYi Zen Hei", "Sans-Serif")
font_weight = 600

[sub_resource type="Theme" id="Theme_controls"]
default_font = SubResource("SystemFont_cjk")
default_font_size = 14

[sub_resource type="GDScript" id="GDScript_controls"]
script/source = "extends Control

@export var compact_scale: float = 0.72
@export var compact_shift: float = 40.0

func _ready() -> void:
	get_viewport().size_changed.connect(_apply_scale)
	call_deferred(\"_apply_scale\")

func _process(_delta: float) -> void:
	var hud := get_parent()
	var start_panel := hud.get_node_or_null(\"StartPanel\") as Control if hud else null
	if is_instance_valid(start_panel):
		visible = not start_panel.visible

func _apply_scale() -> void:
	var compact := get_viewport().get_visible_rect().size.x < 1500.0
	scale = Vector2.ONE * (compact_scale if compact else 1.0)
	var shift := compact_shift if compact else 0.0
	offset_left = -470.0 + shift
	offset_right = 470.0 + shift
	pivot_offset = Vector2(size.x * 0.5, size.y)
"

