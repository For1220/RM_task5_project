[sub_resource type="GDScript" id="GDScript_death_overlay"]
script/source = "extends Control

@onready var respawn_label: Label = $Center/VBox/RespawnLabel


func _ready() -> void:
	visible = false


func _process(_delta: float) -> void:
	var player := get_tree().get_first_node_in_group(\"Player\")
	if player == null:
		visible = false
		return

	var dead := bool(player.get(\"is_dead\"))
	var hud := get_parent()
	var start_panel := hud.get_node_or_null(\"StartPanel\") as Control
	var can_show := dead and (start_panel == null or not start_panel.visible)

	if MatchState.phase_name() == \"ENDED\":
		can_show = false

	visible = can_show
	if not can_show:
		return

	var end_time_value = player.get(\"respawn_end_time\")
	var end_time := float(end_time_value) if end_time_value != null else 0.0
	var left := maxf(end_time - MatchState.elapsed, 0.0)
	respawn_label.text = \"复活倒计时：%d s\" % ceili(left)
"

