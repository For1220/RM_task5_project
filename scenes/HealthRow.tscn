[gd_scene format=3 uid="uid://chealthrow26x"]

[sub_resource type="GDScript" id="GDScript_HealthRow"]
script/source = "extends HBoxContainer\n\nconst ICONS := {\n\t\"base_blue\": \"\",\n\t\"base_red\": \"\",\n\t\"outpost_blue\": \"\",\n\t\"outpost_red\": \"\",\n}\n\n@export_enum(\"base_blue\", \"base_red\", \"outpost_blue\", \"outpost_red\") var icon_key: String = \"base_blue\"\n@export var red_side: bool = false\n@export var is_base: bool = false\n@export var initial_current: int = 5000\n@export var initial_max: int = 5000\n\n@onready var icon: TextureRect = $Icon\n@onready var bar: ProgressBar = $Bar\n@onready var value: Label = $Bar/Value\n\n\nfunc _ready() -> void:\n\t_apply_icon()\n\t_apply_side()\n\t_apply_style()\n\tset_hp(initial_current, initial_max)\n\n\nfunc _apply_icon() -> void:\n\tvar data: String = ICONS.get(icon_key, \"\")\n\tif data.is_empty():\n\t\treturn\n\tvar bytes := Marshalls.base64_to_raw(data)\n\tvar image := Image.new()\n\tif image.load_png_from_buffer(bytes) != OK:\n\t\tpush_warning(\"HealthRow: could not load embedded icon \" + icon_key)\n\t\treturn\n\ticon.texture = ImageTexture.create_from_image(image)\n\n\nfunc _apply_side() -> void:\n\tif red_side:\n\t\tmove_child(icon, get_child_count() - 1)\n\t\tbar.fill_mode = ProgressBar.FILL_END_TO_BEGIN\n\t\tvalue.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT\n\telse:\n\t\tbar.fill_mode = ProgressBar.FILL_BEGIN_TO_END\n\t\tvalue.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT\n\n\nfunc _apply_style() -> void:\n\tvar track := StyleBoxFlat.new()\n\ttrack.bg_color = Color(\"#071019\")\n\ttrack.border_color = Color(1, 1, 1, 0.06)\n\ttrack.set_border_width_all(1)\n\ttrack.set_corner_radius_all(7)\n\tbar.add_theme_stylebox_override(\"background\", track)\n\n\tvar fill := StyleBoxFlat.new()\n\tfill.bg_color = Color(\"#FF5E7A\") if red_side else Color(\"#4D9DFF\")\n\tfill.set_corner_radius_all(7)\n\tbar.add_theme_stylebox_override(\"fill\", fill)\n\n\tbar.modulate.a = 0.76 if is_base else 1.0\n\n\nfunc set_hp(current_hp: int, max_hp: int) -> void:\n\tmax_hp = maxi(max_hp, 1)\n\tcurrent_hp = clampi(current_hp, 0, max_hp)\n\tbar.max_value = float(max_hp)\n\tbar.value = float(current_hp)\n\tvalue.text = \"%d/%d\" % [current_hp, max_hp]\n"

[node name="HealthRow" type="HBoxContainer"]
custom_minimum_size = Vector2(0, 40)
mouse_filter = 2
theme_override_constants/separation = 9
script = SubResource("GDScript_HealthRow")

[node name="Icon" type="TextureRect" parent="."]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Bar" type="ProgressBar" parent="."]
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
show_percentage = false
fill_mode = 0

[node name="Value" type="Label" parent="Bar"]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 9.0
offset_right = -9.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.957, 0.984, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.7)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.55)
theme_override_constants/outline_size = 2
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 1
theme_override_font_sizes/font_size = 11
text = "5000/5000"
horizontal_alignment = 2
vertical_alignment = 1
